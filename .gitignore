# Allow-list: everything is ignored unless listed below. This keeps Polyend's
# firmware (firmware/*.bin, any .ptf), personal projects and renders out of git.
*
!.gitignore
!README.md
!FINDINGS.md
!tracker_emu.py
!m[0-9]*.py
!patch/
!patch/__init__.py
!patch/build.sh
!patch/link.py
!patch/make_ptf.py
!patch/make_probes.py
!patch/master_fx.c
!patch/master_fx_v1.c
!patch/master_fx.bin
!patch/master_fx.bin.syms
!patch/master_fx_v1.bin
!patch/master_fx_v1.bin.syms
!braids/
!braids/build.sh
!braids/braids_voice.cc
!braids/braids_voice.h
!braids/tracker_voice.cc
!braids/braids_unity.cc
!braids/shim/
!braids/shim/*
!braids/THIRD_PARTY_LICENSE.txt
!braids/__init__.py
!braids/gen_resampler.py
!braids/resample_taps.h
!braids/make_templates.py
!braids/build/
!braids/build/braids.bin
!braids/build/braids.bin.syms
!fxbank/
!fxbank/build.sh
!fxbank/fx_bank.c
!fxbank/fx_bank.bin
!fxbank/fx_bank.bin.syms
# never, even if re-included above by mistake
*.ptf
firmware/
projects/
out/
.venv/
__pycache__/
*.o
